{
  "name": "@gpb/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backoffice": {
      "types": "./dist/backoffice.d.ts",
      "import": "./dist/backoffice.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gpb/core": "workspace:*",
    "@orpc/contract": "1.15.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
