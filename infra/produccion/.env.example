# Copiar a `.env` en el VPS, con permisos 600. No se versiona.
#
# Las claves se generan con: openssl rand -base64 48
# PGBACKREST_CIPHER_PASS y ARCHIVOS_CIFRADO_PASS se guardan TAMBIÉN fuera del VPS, en un gestor de
# contraseñas: sin ellas, los backups son basura ilegible. Si se quema el VPS, se queman con él.

POSTGRES_PASSWORD=
PGBACKREST_CIPHER_PASS=
ARCHIVOS_CIFRADO_PASS=

# Cloudflare R2. El endpoint va sin https://, y la clave sólo con permiso sobre este bucket.
R2_ENDPOINT=<id-de-la-cuenta>.r2.cloudflarestorage.com
R2_BUCKET_BACKUPS=garageproboard
R2_ACCESS_KEY=
R2_SECRET_KEY=

# El almacén de archivos de producción, visto desde el VPS (el MinIO que ya está instalado).
ALMACEN_ENDPOINT=http://127.0.0.1:9000
ALMACEN_BUCKET=gpb
ALMACEN_ACCESS_KEY=
ALMACEN_SECRET_KEY=
