	email {$CORREO_ACME:admin@garageproboard.com}
}

www.garageproboard.com, garageproboard.com.ar, www.garageproboard.com.ar {
	redir https://garageproboard.com{uri} permanent
}

garageproboard.com {
	root * /srv/landing
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
