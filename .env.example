# ---------------------------------------------------------------------------
# Copiar a .env y ajustar. El .env NO se versiona.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

# Postgres del contenedor (5433 para no chocar con el PostgreSQL nativo del 5432).
# Este usuario es el DUENIO del esquema: lo usan las migraciones, no la API.
DATABASE_URL=postgres://gpb:gpb_dev@localhost:5433/gpb

# El usuario con el que se conecta la API. Sin BYPASSRLS y sin ser duenio de las
# tablas: es la mitad del aislamiento multi-tenant. La otra mitad es FORCE RLS.
DATABASE_URL_APP=postgres://gpb_app:gpb_app_dev@localhost:5433/gpb
APP_DB_PASSWORD=gpb_app_dev

# El usuario del back-office: ve todas las concesionarias, pero solo sus datos de contrato.
DATABASE_URL_BACKOFFICE=postgres://gpb_backoffice:gpb_backoffice_dev@localhost:5433/gpb
BACKOFFICE_DB_PASSWORD=gpb_backoffice_dev

REDIS_URL=redis://localhost:6379

# API
API_PORT=3080
API_HOST=0.0.0.0

# Auth. En produccion: 32+ bytes aleatorios, uno por entorno.
JWT_SECRET=cambiame-en-produccion-con-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ARCA / AFIP. 'homologacion' hasta tener el circuito probado de punta a punta.
ARCA_ENTORNO=homologacion

# Clave con la que se cifran los certificados de cada empresa en la base.
# Perderla es perder la capacidad de facturar de todos los clientes: respaldala aparte.
SECRETOS_MASTER_KEY=cambiame-32-bytes-en-base64
